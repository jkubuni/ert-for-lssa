# --- 1. GENERAL SETUP ---
ERT_MPI             False
ERT_OPENMP          True
ERT_OPENMP_CFLAGS   -fopenmp
ERT_OPENMP_LDFLAGS  -fopenmp
ERT_PRECISION       FP64    # Critical for fair comparison (Double Precision)
ERT_TRIALS_MIN      1
ERT_TRIALS          3       # Run each test 3 times to filter out background noise
ERT_RESULTS Results/5500U
ERT_GNUPLOT gnuplot
ERT_DRIVER  driver1
ERT_KERNEL  kernel1

# --- 2. COMPILER SETUP ---
ERT_CC              g++
ERT_LD              g++

# --- 3. FLAGS (UNIVERSAL) ---
# Apply to ALL systems (Pi, x86, etc) for consistent optimization rules
ERT_CFLAGS          -O3 -march=native -fopenmp -fstrict-aliasing -funroll-loops -Wno-all
ERT_LDFLAGS         -O3 -march=native -fopenmp
ERT_LDLIBS -lm

# --- 4. EXECUTION ---
ERT_RUN             export OMP_NUM_THREADS=ERT_OPENMP_THREADS; ./ERT_CODE

# --- 5. MEMORY LIMITS ---
# 128 Bytes start ensures we catch L1 Cache. 
# 1 GiB max ensures we break out of 7800X3D L3 Cache.
ERT_WORKING_SET_MIN 128
ERT_MEMORY_MAX      1073741824
ERT_ALIGN           64

# ==========================================================
# [ SYSTEM SPECIFIC ] - CHANGE THESE PER MACHINE
# ==========================================================

# --- SYSTEM: Ryzen 5 5500U ---
ERT_MIN_PROCS       1
ERT_MAX_PROCS       1
ERT_OPENMP_THREADS  1,2,4,8,12      # Logical Threads
ERT_NUM_EXPERIMENTS 5
ERT_FLOPS           1,2,4,8